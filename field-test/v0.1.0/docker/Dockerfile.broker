# agentkeys field-test broker image (M14).
# Pinned at build time: pass PYTHON_IMAGE with a digest for a reproducible field run.
ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=UTC \
    LC_ALL=C \
    NO_COLOR=1 \
    AGENTKEYS_FIELD_ROOT=/work

RUN groupadd -g 10001 agentkeys \
 && useradd -u 10001 -g 10001 --create-home --shell /usr/sbin/nologin agentkeys

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --no-compile .

USER 10001:10001
WORKDIR /work
CMD ["sleep", "infinity"]
